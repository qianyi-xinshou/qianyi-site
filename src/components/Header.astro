---
interface Props { section: string }
const { section } = Astro.props;
const navigation = [
  { section: 'home', href: '/', label: '首页' },
  { section: 'work', href: '/work/', label: '作品' },
  { section: 'about', href: '/about/', label: '关于' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="QIANYI 首页">QIANYI</a>
    <nav id="primary-navigation" class="primary-nav" aria-label="主导航">
      {navigation.map(item => <a href={item.href} aria-current={section === item.section ? (Astro.url.pathname === item.href ? 'page' : 'location') : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-controls">
      <button class="theme-toggle" type="button" aria-label="切换到浅色主题" hidden>
        <span class="theme-icon theme-sun" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></span>
        <span class="theme-icon theme-moon" aria-hidden="true" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z"/></svg></span>
        <span data-theme-label>开灯</span>
      </button>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>菜单<span aria-hidden="true" class="menu-lines"></span></button>
    </div>
  </div>
</header>
